# Snowflake Snowpipe Streaming Connection Settings
# Note: Account identifier format: <orgname>-<accountname> or <locator> (e.g. xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=AJI_LOG_PUSHER_SNOWFLAKE_USER
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=LOG_ANALYTICS_WH
SNOWFLAKE_DATABASE=LOG_ANALYTICS_DB
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_LOG_RECORDS_TABLE=LOG_RECORDS
SNOWFLAKE_INCIDENTS_TABLE=INCIDENTS

# RSA Private Key Configuration for Snowpipe Streaming (JWT authentication)
# Provide the absolute or relative path to the unencrypted PKCS#8 private key file (.p8)
SNOWFLAKE_PRIVATE_KEY_PATH=../snowflake/keys/rsa_key.p8

# Optional: If private key is provided as raw base64 string instead of file:
# SNOWFLAKE_PRIVATE_KEY=
# Optional: If private key is encrypted:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

